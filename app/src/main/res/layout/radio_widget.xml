<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="3dp" android:background="@drawable/scene_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
<TextView android:id="@+id/radio_status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/radio_tile" android:gravity="center" android:text="Radio" android:textSize="14sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:maxLines="2" android:textColor="#F1F5F4" android:textStyle="bold" android:includeFontPadding="false" />
<TextView android:id="@+id/radio_plus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/radio_tile" android:gravity="center" android:text="+" android:textSize="28sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:maxLines="2" android:textColor="#F1F5F4" android:textStyle="bold" android:includeFontPadding="false" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
<TextView android:id="@+id/radio_station" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/radio_tile" android:gravity="center" android:text="FM" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:textColor="#F1F5F4" android:includeFontPadding="false" android:drawableTop="@drawable/radio_icon" android:padding="3dp"/>
<TextView android:id="@+id/radio_minus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/radio_tile" android:gravity="center" android:text="−" android:textSize="28sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:maxLines="2" android:textColor="#F1F5F4" android:textStyle="bold" android:includeFontPadding="false" />
</LinearLayout>
</LinearLayout>