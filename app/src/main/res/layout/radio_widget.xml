<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="3dp" android:background="@drawable/radio_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
<FrameLayout android:id="@+id/radio_power_tile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/radio_round_tile">
  <ImageView android:id="@+id/radio_power_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/radio_power_off" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
  <TextView android:id="@+id/radio_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="1dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:gravity="center" android:text="?" android:textSize="10sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A9B9E" android:importantForAccessibility="no"/>
</FrameLayout>
<TextView android:id="@+id/radio_plus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/radio_round_tile" android:gravity="center" android:text="+" android:textSize="28sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:maxLines="2" android:textColor="#F1F5F4" android:textStyle="bold" android:includeFontPadding="false" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
<FrameLayout android:id="@+id/radio_station_tile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/radio_round_tile">
  <ImageView android:id="@+id/radio_station" android:layout_width="26dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/radio_receiver_off" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
  <TextView android:id="@+id/radio_station_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="1dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:gravity="center" android:text="FM" android:textSize="10sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A9B9E" android:importantForAccessibility="no"/>
</FrameLayout>
<TextView android:id="@+id/radio_minus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/radio_round_tile" android:gravity="center" android:text="−" android:textSize="28sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:maxLines="2" android:textColor="#F1F5F4" android:textStyle="bold" android:includeFontPadding="false" />
</LinearLayout>
</LinearLayout>