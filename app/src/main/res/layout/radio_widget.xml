<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scene_background">
<ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/dz_logo" android:alpha="0.17" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="3dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"><TextView android:id="@+id/radio_up" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/radio_tile" android:gravity="center" android:text="▲" android:textSize="25sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="25sp" android:autoSizeStepGranularity="1sp" android:maxLines="2" android:textColor="#F1F5F4" android:textStyle="bold" android:includeFontPadding="false"/><TextView android:id="@+id/radio_living" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/radio_tile" android:gravity="center" android:text="Wohnzimmer" android:textSize="14sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:maxLines="2" android:textColor="#F1F5F4" android:textStyle="bold" android:includeFontPadding="false"/><TextView android:id="@+id/radio_plus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/radio_tile" android:gravity="center" android:text="+" android:textSize="28sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:maxLines="2" android:textColor="#F1F5F4" android:textStyle="bold" android:includeFontPadding="false"/></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"><TextView android:id="@+id/radio_down" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/radio_tile" android:gravity="center" android:text="▼" android:textSize="25sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="25sp" android:autoSizeStepGranularity="1sp" android:maxLines="2" android:textColor="#F1F5F4" android:textStyle="bold" android:includeFontPadding="false"/><TextView android:id="@+id/radio_dining" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/radio_tile" android:gravity="center" android:text="Esstisch" android:textSize="14sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:maxLines="2" android:textColor="#F1F5F4" android:textStyle="bold" android:includeFontPadding="false"/><TextView android:id="@+id/radio_minus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_margin="2dp" android:background="@drawable/radio_tile" android:gravity="center" android:text="−" android:textSize="28sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:maxLines="2" android:textColor="#F1F5F4" android:textStyle="bold" android:includeFontPadding="false"/></LinearLayout><TextView android:id="@+id/radio_station" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="FM" android:textColor="#FFBD85" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/><TextView android:id="@+id/radio_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Status prüfen" android:textColor="#FFBD85" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
</LinearLayout></FrameLayout>