<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:background="@drawable/scene_background" android:padding="10dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
  <LinearLayout android:id="@+id/scene_run" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
   <ImageView android:id="@+id/scene_brand" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/dz_logo" android:contentDescription="Onkyo dahoam" android:layout_marginEnd="5dp"/>
   <TextView android:id="@+id/scene_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#7BD8BC" android:textSize="22sp" android:paddingEnd="8dp" android:text="▶"/>
   <TextView android:id="@+id/scene_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#F1F5F4" android:textStyle="bold" android:textSize="16sp" android:maxLines="2" android:ellipsize="end"/>
  </LinearLayout>
  <TextView android:id="@+id/scene_check" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center" android:text="↻" android:textSize="24sp" android:textColor="#D2E0DF" android:contentDescription="Verbindung prüfen, ohne Szene zu starten"/>
  <TextView android:id="@+id/scene_edit" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center" android:text="⚙" android:textSize="22sp" android:textColor="#D2E0DF" android:contentDescription="Szene bearbeiten"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/scene_actions" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
  <TextView android:id="@+id/scene_main" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F1F5F4" android:textSize="13sp" android:maxLines="2" android:ellipsize="end"/>
  <TextView android:id="@+id/scene_second" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F1F5F4" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:paddingTop="2dp"/>
  <TextView android:id="@+id/scene_shared" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C2D0D1" android:textSize="11sp" android:maxLines="1" android:visibility="gone"/>
 </LinearLayout>
 <TextView android:id="@+id/scene_connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C2D0D1" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:paddingTop="4dp"/>
 <TextView android:id="@+id/scene_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C2D0D1" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:paddingTop="2dp"/>
</LinearLayout>
