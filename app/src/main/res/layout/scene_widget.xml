<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="horizontal" android:background="@drawable/scene_background" android:padding="9dp">
 <LinearLayout android:id="@+id/scene_run" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
   <TextView android:id="@+id/scene_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#7BD8BC" android:textSize="20sp" android:paddingEnd="6dp" android:text="▶"/>
   <TextView android:id="@+id/scene_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#F1F5F4" android:textStyle="bold" android:textSize="16sp" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
  <TextView android:id="@+id/scene_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D2E0DF" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"/>
  <TextView android:id="@+id/scene_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A9D7C9" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
 </LinearLayout>
 <TextView android:id="@+id/scene_edit" android:layout_width="38dp" android:layout_height="match_parent" android:gravity="center" android:text="⚙" android:textSize="20sp" android:textColor="#D2E0DF" android:contentDescription="Szene bearbeiten"/>
</LinearLayout>
